TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
JIMMY_ALLOWED_USER_IDS=
# Transport: telegram (default) or slack. The slack transport reads
# SLACK_BOT_TOKEN and SLACK_APP_TOKEN instead of TELEGRAM_BOT_TOKEN.
# JIMMY_TRANSPORT=telegram
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Groq key for voice message transcription (whisper-large-v3). Leave unset to reject voice notes.
TRANSCRIBE_API_KEY=
# Google AI Studio key for the gen-image tool. Leave unset to disable it.
GEMINI_API_KEY=
# Fine-grained PAT with Contents: RW and Pull requests: RW for the repo, so Jimmy
# can push a branch and open a PR. Leave unset to disable self-improvement.
GITHUB_TOKEN=
# AXE_BASE=https://api.deepseek.com
# AXE_MODEL=deepseek-flash
# AXE_CONTEXT_WINDOW=1000000
