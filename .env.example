OPENAI_API_KEY=
JIMMY_ALLOWED_USER_IDS=
# Transport: none (default) or slack. Slack reads SLACK_BOT_TOKEN and SLACK_APP_TOKEN.
# JIMMY_TRANSPORT=slack
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Google AI Studio key for the gen-image tool. Leave unset to disable it.
GEMINI_API_KEY=
# Directory with Agent Skills. Defaults to $JIMMY_ROOT/skills.
# JIMMY_SKILLS=
# Fine-grained PAT with Contents: RW and Pull requests: RW for the repo, so Jimmy
# can push a branch and open a PR. Leave unset to disable self-improvement.
GITHUB_TOKEN=
# AXE_BASE=https://api.deepseek.com
# AXE_MODEL=deepseek-flash
# AXE_CONTEXT_WINDOW=1000000
# Web frontend. Without a port, nobody serves HTTP.
# JIMMY_WEB_PORT=8080
# Who can ask for a link, comma separated. Empty means nobody.
# JIMMY_WEB_EMAILS=
# Resend sends the link. Without a key nobody can log in.
# RESEND_API_KEY=
# JIMMY_WEB_FROM=Jimmy <jimmy@ejemplo.com>
# Public URL the link points to. Defaults to https://<host>.
# JIMMY_WEB_URL=
# 1 returns the link in the response instead of mailing it, for development.
# JIMMY_WEB_DEV=
# The shipped prompt fragments use {{usuario}} and {{asistente}}, so both are
# needed or jimmy refuses to start. Put your own name here.
JIMMY_VARS=usuario=Ana,asistente=Jimmy
# OAuth clients for the connections the web can start at /oauth/start. The
# names are per provider; the tokens land in the vault, one environment per
# account. Notion needs a public connection with <JIMMY_WEB_URL>/oauth/callback
# as a redirect URI.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
