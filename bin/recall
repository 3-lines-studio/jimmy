#!/usr/bin/env python3
import json
import sys


def read_entries(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def turns(path):
    for entry in read_entries(path):
        kind = entry.get("type")
        if kind == "message":
            message = entry.get("message", {})
            role = message.get("Role", "")
            content = message.get("Content", "")
            if role in ("user", "assistant") and content.strip():
                yield role, content.strip()
        elif kind == "compaction":
            summary = entry.get("summary", "")
            if summary.strip():
                yield "compaction", summary.strip()


def main():
    args = sys.argv[1:]
    limit = 20
    if args and args[0] == "-n":
        limit = int(args[1])
        args = args[2:]
    if not args:
        sys.exit("uso: recall [-n N] <transcript.jsonl> [consulta]")
    path, query = args[0], " ".join(args[1:]).lower()
    found = [t for t in turns(path) if not query or query in t[1].lower()]
    for role, content in found[-limit:]:
        print(f"[{role}] {content}\n")


if __name__ == "__main__":
    main()
